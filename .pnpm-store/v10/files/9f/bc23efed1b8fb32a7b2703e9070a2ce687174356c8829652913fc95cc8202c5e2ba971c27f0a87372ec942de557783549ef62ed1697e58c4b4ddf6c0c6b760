 last_value) / (ctx._dt || 1 / 60); // guard div by 0\n\t\tlet spring = ctx._stiffness * delta;\n\t\tlet damper = ctx._damping * velocity;\n\t\tlet acceleration = (spring - damper) * ctx._inv_mass;\n\t\tlet d = (velocity + acceleration) * ctx._dt;\n\t\tif (Math.abs(d) < ctx._precision && Math.abs(delta) < ctx._precision) {\n\t\t\treturn target_value; // settled\n\t\t} else {\n\t\t\tctx._settled = false; // signal loop to keep ticking\n\t\t\treturn is_date(current_value)\n\t\t\t\t? new Date(current_value.getTime() + d)\n\t\t\t\t: current_value + d;\n\t\t}\n\t} else if (Array.isArray(current_value)) {\n\t\treturn current_value.map((_, i) =>\n\t\t\ttick_spring(ctx, last_value[i], current_value[i], target_value[i])\n\t\t);\n\t} else if (typeof current_value === \"object\") {\n\t\tlet next_value = {};\n\t\tfor (let k in current_value) {\n\t\t\t// @ts-expect-error next_value is just an object\n\t\t\tnext_value[k] = tick_spring(\n\t\t\t\tctx,\n\t\t\t\tlast_value[k],\n\t\t\t\tcurrent_value[k],\n\t\t\t\ttarget_value[k]\n\t\t\t);\n\t\t}\n\t\treturn next_value;\n\t} else {\n\t\tdev: {\n\t\t\tthrow new Error(`Cannot spring ${typeof current_value} values`);\n\t\t}\n\t}\n};\n\nexport interface SpringOptions {\n\tstiffness?: number;\n\tdamping?: number;\n\tprecision?: number;\n}\nexport interface SpringState<T> {\n\tstiffness: number;\n\tdamping: number;\n\tprecision: number;\n\n\ttarget: T;\n\tcurrent: T;\n}\nexport type Spring<T> = Stateful<SpringState<T>>;\n\nlet timeNow = () => performance.now();\n\nexport let createSpring = <T>(val: T, opts: SpringOptions = {}): Spring<T> => {\n\tlet state = createState({\n\t\tstiffness: opts.stiffness ?? 0.15,\n\t\tdamping: opts.damping ?? 0.8,\n\t\tprecision: opts.precision ?? 0.01,\n\n\t\ttarget: val,\n\t\tcurrent: val,\n\t} satisfies SpringState<T>);\n\n\tlet settling = false;\n\tlet last_time = 0;\n\tlet last_value = val;\n\tlet _inv_mass = 1;\n\tlet inv_mass_recovery_rate = 0;\n\tlet momentum = 0;\n\n\tlet update = () => {\n\t\tlet now = timeNow();\n\n\t\t_inv_mass = Math.min(_inv_mass + inv_mass_recovery_rate, 1);\n\t\tlet elapsed = Math.min(now - last_time, 1000 / 30);\n\n\t\tlet ctx = {\n\t\t\t_inv_mass,\n\t\t\t_settled: true,\n\t\t\t_dt: (elapsed * 60) / 1000,\n\n\t\t\t_stiffness: state.stiffness,\n\t\t\t_damping: state.damping,\n\t\t\t_precision: state.precision,\n\t\t} satisfies TickContext;\n\t\tlet next = tick_spring(ctx, last_value, state.current, state.target);\n\t\tlast_value = state.current;\n\t\tlast_time = now;\n\t\tstate.current = next;\n\n\t\tif (ctx._settled) settling = false;\n\t\telse requestAnimationFrame(update);\n\t};\n\n\tuse(state.target).listen((_) => {\n\t\tif (!settling) {\n\t\t\tlast_time = timeNow();\n\t\t\tinv_mass_recovery_rate = 1000 / (momentum * 60);\n\t\t\tsettling = true;\n\t\t\trequestAnimationFrame(update);\n\t\t}\n\t});\n\n\treturn state;\n};\n"],"names":["is_date","val","Date","tick_spring","ctx","last_value","current_value","target_value","delta","velocity","_dt","d","_stiffness","_damping","_inv_mass","Math","abs","_precision","_settled","getTime","Array","isArray","map","_","i","next_value","k","timeNow","performance","now","createSpring","opts","state","createState","stiffness","damping","precision","target","current","settling","last_time","inv_mass_recovery_rate","update","min","next","requestAnimationFrame","use","listen"],"mappings":"6CA0BA,IAAIA,EAAWC,GAA0BA,aAAeC,KAEpDC,EAAc,CACjBC,EACAC,EACAC,EACAC,KAEA,GAA6B,iBAAlBD,GAA8BN,EAAQM,GAAgB,CAEhE,IAAIE,EAAQD,EAAeD,EAEvBG,GAAYH,EAAgBD,IAAeD,EAAIM,GAAO,EAAI,IAI1DC,GAAKF,GAHIL,EAAIQ,EAAaJ,EACjBJ,EAAIS,EAAWJ,GACWL,EAAIU,GACPV,EAAIM,EACxC,OAAIK,KAAKC,IAAIL,GAAKP,EAAIa,GAAcF,KAAKC,IAAIR,GAASJ,EAAIa,EAClDV,GAEPH,EAAIc,GAAW,EACRlB,EAAQM,GACZ,IAAIJ,KAAKI,EAAca,UAAYR,GACnCL,EAAgBK,GAEd,GAAIS,MAAMC,QAAQf,GACxB,OAAOA,EAAcgB,IAAI,CAACC,EAAGC,IAC5BrB,EAAYC,EAAKC,EAAWmB,GAAIlB,EAAckB,GAAIjB,EAAaiB,KAE1D,GAA6B,iBAAlBlB,EAA4B,CAC7C,IAAImB,EAAa,CAAA,EACjB,IAAK,IAAIC,KAAKpB,EAEbmB,EAAWC,GAAKvB,EACfC,EACAC,EAAWqB,GACXpB,E