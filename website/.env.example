# Server-side only. Never put the secret key in public/ or GitHub Pages variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
SITE_OWNER_EMAIL=owner@example.com
AUTH_SITE_URL=https://majorand.github.io/Canvas/
# On hosted Node services, bind the public interface. Keep local development on loopback.
# HOST=0.0.0.0
# Comma-separated browser origins. A * matches one hostname label and must keep a two-label suffix.
# ALLOWED_ORIGINS=https://majorand.github.io,https://your-site.netlify.app,https://*--your-site.netlify.app
